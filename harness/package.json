	},
	"engines": {
		"node": ">=22.19.0"
	},
	"overrides": {
		"protobufjs": "7.6.6",
		"brace-expansion": "5.0.12",
		"shell-quote": "1.12.0"
	},
	"version": "0.0.3"
}
